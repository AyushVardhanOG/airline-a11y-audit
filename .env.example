# LLM settings for src/repair.py (Step 5).
# Copy this file to ".env" and fill it in. ".env" is git-ignored: NEVER commit it
# (it may contain an API key). This example file contains no secrets.

# Option A (recommended): local Ollama - free, no account, nothing leaves your computer
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5-coder:7b
OLLAMA_URL=http://localhost:11434

# Option B: a free online API that offers an OpenAI-compatible endpoint
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://example-provider.com/v1
# LLM_MODEL=model-name-from-the-provider
# LLM_API_KEY=paste-your-key-here
