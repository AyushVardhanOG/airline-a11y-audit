# Python virtual environment (each person creates their own)
.venv/
__pycache__/
*.pyc

# Node packages (re-created with `npm install`)
node_modules/

# Secrets such as LLM API keys - never commit these
.env

# Privacy: block pages can show our own public IP address. Keep these local only.
# - screenshots of block pages (the scanner names them *_blocked.png)
screenshots/**/*_blocked.png
# - Step 2 run 20261111T115319Z was made before IP redaction was added. Its Lufthansa
#   files contain the IP. They stay on disk untouched (rule 6) but are not published.
data/raw/step2_feasibility/20261111T115319Z/lufthansa.json
screenshots/step2_feasibility/20261111T115319Z/lufthansa.png

# Saved SingleFile page copies: full copies of airlines' pages (copyright) that can
# also contain details about the person who captured them. Kept locally + backed up.
# data/captures/log.csv and the SingleFile settings ARE committed.
data/captures/*.html
# ...including subfolders such as data/captures/_duplicates/ (the line above only
# covers files directly in data/captures/)
data/captures/**/*.html

# Editor / OS clutter
.vscode/
.idea/
Thumbs.db
.DS_Store
